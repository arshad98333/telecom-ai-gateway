# The two services live here, as subtrees. They were separate repositories; their
# history came across with them, so `git log -- telecom-mcp` is still the real story.

__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
uv.lock.bak
.env
.env.*
!.env.example

# Kept out of the way after the subtree merge; safe to delete once the push looks right.
.git-backups/
.audit-requirements.txt

# Local Azure CLI dumps and generated deploy state — never commit.
azrevs.json
azstate.json
*.bundle
scripts/azure-deploy.config.json
