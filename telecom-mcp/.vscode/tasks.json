{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "uv sync --frozen --all-extras",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Mint a token (writes it into .env)",
      "detail": "Sets DEV_TOKEN so requests.http picks it up. Both services accept it",
      "type": "shell",
      "command": "uv run --env-file .env python scripts/mint_dev_token.py --role ${input:role} --write-env",
      "problemMatcher": []
    },
    {
      "label": "Mint a narrower token, to watch a refusal",
      "detail": "A token holding only the scopes you pick, so RBAC has something to refuse",
      "type": "shell",
      "command": "uv run --env-file .env python scripts/mint_dev_token.py --scope \"${input:scope}\" --write-env",
      "problemMatcher": []
    },
    {
      "label": "Print a token, without touching .env",
      "type": "shell",
      "command": "uv run --env-file .env python scripts/mint_dev_token.py --role ${input:role}",
      "problemMatcher": []
    },
    {
      "label": "Smoke test the whole chain",
      "detail": "Nine checks against both running services",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke.ps1",
      "linux": { "command": "pwsh -NoProfile -File ./scripts/smoke.ps1" },
      "osx": { "command": "pwsh -NoProfile -File ./scripts/smoke.ps1" },
      "problemMatcher": []
    },
    {
      "label": "Check the configuration",
      "type": "shell",
      "command": "uv run --env-file .env telecom-mcp check-config",
      "problemMatcher": []
    },
    {
      "label": "Verify an audit log",
      "detail": "Reads a JSON-lines audit log and reports whether its chain is intact",
      "type": "shell",
      "command": "uv run telecom-mcp verify-audit ${input:auditPath}",
      "problemMatcher": []
    },
    {
      "label": "Run the tests",
      "type": "shell",
      "command": "uv run pytest -q",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Everything CI runs",
      "type": "shell",
      "command": "uv run ruff format --check . && uv run ruff check . && uv run mypy && uv run pytest --cov -q",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "role",
      "type": "pickString",
      "description": "Which identity should the token carry?",
      "options": ["customer", "support_agent", "supervisor_approver", "admin_security"],
      "default": "customer"
    },
    {
      "id": "scope",
      "type": "pickString",
      "description": "Which scopes should the token carry?",
      "options": [
        "account:read",
        "account:read service:read",
        "account:read billing:read",
        "billing:read"
      ],
      "default": "account:read"
    },
    {
      "id": "auditPath",
      "type": "promptString",
      "description": "Path to a JSON-lines audit log",
      "default": "audit.log"
    }
  ]
}
