# The external-test profile: tool-server overrides. See middleware.env for the reasoning.

TELECOM_MCP_HTTP_HOST=0.0.0.0

# Same token, same secret, both hops. The tool server verifies the caller's token and
# then forwards that same token to the middleware, so a mismatch here shows up as a
# refusal there and looks like a middleware bug.
TELECOM_MCP_IDENTITY_VERIFIER=local

# The tool server's LocalVerifier checks this audience, and the middleware checks the
# same string. mint_dev_token.py puts both audiences in the token.
TELECOM_MCP_JWT_AUDIENCE=https://api.telecom.example/v1

# Talk to the local middleware, not to a deployed one - the point of the exercise is
# that the pair in front of you is what gets tested.
TELECOM_MCP_BACKEND=http
TELECOM_MCP_BACKEND_BASE_URL=http://127.0.0.1:9000/api/v1

# The middleware is running with SERVICE_AUTH=unchecked in this profile, so the tool
# server does not need to fetch a real client-credentials token from Auth0 first -
# which it cannot do if the tenant is unreachable, and which would fail the whole boot.
TELECOM_MCP_SERVICE_IDENTITY_SOURCE=static
