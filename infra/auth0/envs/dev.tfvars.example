# Copy to dev.tfvars and fill in. Never commit the filled version: it names your tenant
# and, if you put the secret here rather than in the environment, leaks it.
environment  = "dev"
auth0_domain = "your-tenant-dev.eu.auth0.com"

# Prefer the environment for these two:
#   export TF_VAR_auth0_management_client_id=...
#   export TF_VAR_auth0_management_client_secret=...
auth0_management_client_id     = "REPLACE_ME"
auth0_management_client_secret = "REPLACE_ME"

api_identifier  = "https://api.telecom.example/v1"
claim_namespace = "https://telecom.example/"

console_callback_urls = ["http://localhost:5173/callback"]
token_lifetime_seconds = 900
