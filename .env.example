# Every variable the application reads. Copy to .env and fill in.
# Nothing here is a real secret; the real .env is gitignored and never committed.

# --- Runtime -----------------------------------------------------------------
TELECOM_MCP_ENV=local                  # local | staging | production
TELECOM_MCP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
TELECOM_MCP_SERVICE_NAME=telecom-mcp-tools

# --- HTTP transport (only read when transport=http) --------------------------
TELECOM_MCP_HTTP_HOST=127.0.0.1
TELECOM_MCP_HTTP_PORT=8080

# --- Telecom middleware API (the only way we reach customer data) ------------
# The package never connects to MongoDB directly; it calls this service.
TELECOM_MCP_BACKEND=fake               # fake | http   (fake needs no network)
TELECOM_MCP_BACKEND_BASE_URL=http://127.0.0.1:9000/api/v1
TELECOM_MCP_BACKEND_API_KEY=dummy-backend-key
TELECOM_MCP_BACKEND_CONNECT_TIMEOUT_S=2.0
TELECOM_MCP_BACKEND_READ_TIMEOUT_S=8.0
TELECOM_MCP_BACKEND_MAX_CONNECTIONS=50

# --- This service's own credential -------------------------------------------
# Sent as X-Service-Authorization; proves which service is calling, never who for.
#   static             the API key above, unchanged. Development only.
#   client_credentials fetched from the identity provider and refreshed before it
#                      expires. Required in production - an Auth0 access token lives
#                      minutes, so a pasted one stops working almost immediately.
TELECOM_MCP_SERVICE_IDENTITY_SOURCE=static
TELECOM_MCP_SERVICE_TOKEN_URL=https://your-tenant.us.auth0.com/oauth/token
TELECOM_MCP_SERVICE_CLIENT_ID=
TELECOM_MCP_SERVICE_CLIENT_SECRET=
# Defaults to TELECOM_MCP_JWT_AUDIENCE: the credential is minted for the API called.
TELECOM_MCP_SERVICE_TOKEN_AUDIENCE=https://api.telecom.example/v1

# --- Identity (Auth0) --------------------------------------------------------
# This server forwards the caller's token to the middleware, which verifies it again,
# so all four values below must match the TELECOM_MW_* equivalents. In particular an
# Auth0 access token carries exactly one audience: both services front one Auth0 API.
# Walkthrough: docs/AUTH0-INTEGRATION.md
TELECOM_MCP_IDENTITY_VERIFIER=local       # local | jwks   (local is for tests/dev only)
TELECOM_MCP_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json
TELECOM_MCP_JWT_ISSUER=https://your-tenant.eu.auth0.com/
TELECOM_MCP_JWT_AUDIENCE=https://api.telecom.example/v1
TELECOM_MCP_LOCAL_VERIFIER_SECRET=dummy-local-signing-secret-change-me-32b
TELECOM_MCP_JWKS_CACHE_TTL_S=600
# Prefix on the custom claims carrying tenant, role and customer reference. Must match
# the namespace your identity provider's post-login action writes and the one the
# backing API reads. Must end with '/'.
TELECOM_MCP_CLAIM_NAMESPACE=https://telecom.example/

# --- Reliability -------------------------------------------------------------
TELECOM_MCP_TOOL_TIMEOUT_S=10.0        # total budget per tool call (SOP: 10s)
TELECOM_MCP_RETRY_ATTEMPTS=2           # retries after the first try, safe operations only
TELECOM_MCP_RETRY_BASE_DELAY_S=0.2
TELECOM_MCP_BREAKER_FAILURE_THRESHOLD=5
TELECOM_MCP_BREAKER_RESET_TIMEOUT_S=30.0
TELECOM_MCP_MAX_CONCURRENT_TOOL_CALLS=100

# --- Idempotency -------------------------------------------------------------
TELECOM_MCP_IDEMPOTENCY_STORE=memory   # memory | redis
TELECOM_MCP_IDEMPOTENCY_TTL_S=86400    # 24 hours
TELECOM_MCP_REDIS_URL=redis://localhost:6379/0

# --- Telemetry ---------------------------------------------------------------
# Traces. Off by default so a laptop needs no collector; production refuses to start
# without it. Enabling tracing with no exporter is refused rather than accepted,
# because building every span and discarding it is waste nobody notices for a quarter.
TELECOM_MCP_TRACING_ENABLED=false
TELECOM_MCP_TRACE_EXPORTER=none         # none | otlp | azure_monitor
TELECOM_MCP_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TELECOM_MCP_TRACE_SAMPLE_RATIO=1.0      # parent-based; lower it when volume justifies

# Application Insights. Contains the instrumentation key, so it is a secret: it comes
# from Key Vault in staging and production, and only lives here on a developer machine.
TELECOM_MCP_APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://uksouth-1.in.applicationinsights.azure.com/

# --- Azure -------------------------------------------------------------------
# The application needs none of these at run time. In Azure it authenticates with a
# managed identity; in CI the pipeline federates through OIDC. They are here so that a
# developer working against real resources, and the scripts in scripts/, read one file.
#
# Where each value comes from:
#   TENANT_ID        az account show --query tenantId -o tsv
#   SUBSCRIPTION_ID  az account show --query id -o tsv
#   CLIENT_ID        the app registration or user-assigned identity you created;
#                    az identity show -g <rg> -n <name> --query clientId -o tsv
#   CLIENT_SECRET    only for a developer machine. Never set in staging or production:
#                    a managed identity has no secret and a pipeline OIDC token has no
#                    secret, and a secret that exists is a secret that leaks.
#   KEY_VAULT_NAME   az keyvault list -g <rg> --query "[0].name" -o tsv
TELECOM_MCP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
TELECOM_MCP_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
TELECOM_MCP_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
TELECOM_MCP_AZURE_CLIENT_SECRET=
TELECOM_MCP_AZURE_KEY_VAULT_NAME=kv-telecom-mcp-dev

# The Azure CLI and any SDK using DefaultAzureCredential read these unprefixed names
# straight from the process environment; the application itself never looks at them.
# Set them to the same values above when you want `az` and a local SDK call to agree.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://uksouth-1.in.applicationinsights.azure.com/

# --- Guardrails --------------------------------------------------------------
# The layer that runs either side of the backend, asking whether the call is sane
# rather than whether the caller is allowed. Reference: docs/guardrails.md
# The defaults below are the strict ones. Every value exists so an environment can
# tighten it; loosening one should show up in a diff and be argued for.
TELECOM_MCP_GUARDRAILS_ENABLED=true    # refused in production when false

# Argument size and shape. A tool argument is a customer's sentence, not a file.
TELECOM_MCP_GUARDRAIL_MAX_ARGUMENT_BYTES=8192
TELECOM_MCP_GUARDRAIL_MAX_ARGUMENT_DEPTH=6
TELECOM_MCP_GUARDRAIL_MAX_STRING_LENGTH=4096
TELECOM_MCP_GUARDRAIL_MAX_ARRAY_ITEMS=100
TELECOM_MCP_GUARDRAIL_MAX_OBJECT_KEYS=50

# Content. Free text that reads as an instruction to the model is refused.
TELECOM_MCP_GUARDRAIL_INJECTION_SCAN=true   # refused in production when false

# Volume. The bucket is per identity and refills continuously.
TELECOM_MCP_GUARDRAIL_RATE_LIMIT_PER_MINUTE=120
TELECOM_MCP_GUARDRAIL_RATE_LIMIT_BURST=30

# Consequences. Irreversible actions on one case, in a rolling window.
TELECOM_MCP_GUARDRAIL_WRITE_ACTIONS_PER_CASE=5
TELECOM_MCP_GUARDRAIL_ACTION_BUDGET_WINDOW_S=3600

# Business sanity the frozen v1 contract cannot express.
TELECOM_MCP_GUARDRAIL_CALLBACK_HORIZON_DAYS=90
TELECOM_MCP_GUARDRAIL_REFUND_CEILING=5.00   # at or below the contract's 5.00 cap

# Output. The last look at a response before the model sees it.
TELECOM_MCP_GUARDRAIL_MAX_OUTPUT_BYTES=262144
TELECOM_MCP_GUARDRAIL_OUTPUT_SECRET_SCAN=true   # refused in production when false

# --- Audit -------------------------------------------------------------------
TELECOM_MCP_AUDIT_SINK=stdout          # stdout | file
TELECOM_MCP_AUDIT_FILE_PATH=./audit.log
