# Every variable the application reads. Copy to .env and fill in.
# Nothing here is a real secret; the real .env is gitignored and never committed.

# --- Runtime -----------------------------------------------------------------
TELECOM_MCP_ENV=local                  # local | staging | production
TELECOM_MCP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
TELECOM_MCP_SERVICE_NAME=telecom-mcp-tools

# --- HTTP transport (only read when transport=http) --------------------------
TELECOM_MCP_HTTP_HOST=127.0.0.1
TELECOM_MCP_HTTP_PORT=8080

# --- Telecom middleware API (the only way we reach customer data) ------------
# The package never connects to MongoDB directly; it calls this service.
TELECOM_MCP_BACKEND=fake               # fake | http   (fake needs no network)
TELECOM_MCP_BACKEND_BASE_URL=http://127.0.0.1:9000/api/v1
TELECOM_MCP_BACKEND_API_KEY=dummy-backend-key
TELECOM_MCP_BACKEND_CONNECT_TIMEOUT_S=2.0
TELECOM_MCP_BACKEND_READ_TIMEOUT_S=8.0
TELECOM_MCP_BACKEND_MAX_CONNECTIONS=50

# --- This service's own credential -------------------------------------------
# Sent as X-Service-Authorization; proves which service is calling, never who for.
#   static             the API key above, unchanged. Development only.
#   client_credentials fetched from the identity provider and refreshed before it
#                      expires. Required in production - an Auth0 access token lives
#                      minutes, so a pasted one stops working almost immediately.
TELECOM_MCP_SERVICE_IDENTITY_SOURCE=static
TELECOM_MCP_SERVICE_TOKEN_URL=https://your-tenant.us.auth0.com/oauth/token
TELECOM_MCP_SERVICE_CLIENT_ID=
TELECOM_MCP_SERVICE_CLIENT_SECRET=
# Defaults to TELECOM_MCP_JWT_AUDIENCE: the credential is minted for the API called.
TELECOM_MCP_SERVICE_TOKEN_AUDIENCE=https://api.telecom.example/v1

# --- Identity (Auth0) --------------------------------------------------------
# This server forwards the caller's token to the middleware, which verifies it again,
# so all four values below must match the TELECOM_MW_* equivalents. In particular an
# Auth0 access token carries exactly one audience: both services front one Auth0 API.
# Walkthrough: docs/AUTH0-INTEGRATION.md
TELECOM_MCP_IDENTITY_VERIFIER=local       # local | jwks   (local is for tests/dev only)
TELECOM_MCP_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json
TELECOM_MCP_JWT_ISSUER=https://your-tenant.eu.auth0.com/
TELECOM_MCP_JWT_AUDIENCE=https://api.telecom.example/v1
TELECOM_MCP_LOCAL_VERIFIER_SECRET=dummy-local-signing-secret-change-me-32b
TELECOM_MCP_JWKS_CACHE_TTL_S=600
# Prefix on the custom claims carrying tenant, role and customer reference. Must match
# the namespace your identity provider's post-login action writes and the one the
# backing API reads. Must end with '/'.
TELECOM_MCP_CLAIM_NAMESPACE=https://telecom.example/

# --- Reliability -------------------------------------------------------------
TELECOM_MCP_TOOL_TIMEOUT_S=10.0        # total budget per tool call (SOP: 10s)
TELECOM_MCP_RETRY_ATTEMPTS=2           # retries after the first try, safe operations only
TELECOM_MCP_RETRY_BASE_DELAY_S=0.2
TELECOM_MCP_BREAKER_FAILURE_THRESHOLD=5
TELECOM_MCP_BREAKER_RESET_TIMEOUT_S=30.0
TELECOM_MCP_MAX_CONCURRENT_TOOL_CALLS=100

# --- Idempotency -------------------------------------------------------------
TELECOM_MCP_IDEMPOTENCY_STORE=memory   # memory | redis
TELECOM_MCP_IDEMPOTENCY_TTL_S=86400    # 24 hours
TELECOM_MCP_REDIS_URL=redis://localhost:6379/0

# --- Audit -------------------------------------------------------------------
TELECOM_MCP_AUDIT_SINK=stdout          # stdout | file
TELECOM_MCP_AUDIT_FILE_PATH=./audit.log
