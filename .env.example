# Every variable the service reads. Copy to .env and fill in.
# Nothing here is a real secret; the real .env is gitignored and never committed.

# --- Runtime -----------------------------------------------------------------
TELECOM_MW_ENV=local                     # local | staging | production
TELECOM_MW_LOG_LEVEL=INFO
TELECOM_MW_SERVICE_NAME=telecom-middleware
TELECOM_MW_HTTP_HOST=127.0.0.1
TELECOM_MW_HTTP_PORT=9000

# --- Storage ------------------------------------------------------------------
# "memory" needs no database and is for development and tests only; production
# refuses it. A replica set is required for transactions and change streams.
TELECOM_MW_STORE=memory                  # memory | mongodb
TELECOM_MW_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
TELECOM_MW_MONGODB_DATABASE=telecom
TELECOM_MW_MONGODB_MAX_POOL_SIZE=100
TELECOM_MW_MONGODB_TIMEOUT_MS=5000

# --- Identity (Auth0) ---------------------------------------------------------
TELECOM_MW_IDENTITY_VERIFIER=local       # local | jwks   (local is dev/test only)
TELECOM_MW_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json
TELECOM_MW_JWT_ISSUER=https://your-tenant.eu.auth0.com/
TELECOM_MW_JWT_AUDIENCE=https://api.telecom.example/v1
TELECOM_MW_LOCAL_VERIFIER_SECRET=dummy-local-signing-secret-change-me-32b
TELECOM_MW_JWKS_CACHE_TTL_S=600
TELECOM_MW_CLAIM_NAMESPACE=https://telecom.example/

# --- Passcode policy ----------------------------------------------------------
# A four-digit secret is weak by construction, so the controls around it carry the load.
TELECOM_MW_PASSCODE_MAX_ATTEMPTS=5
TELECOM_MW_PASSCODE_LOCKOUT_S=900

# --- Realtime -----------------------------------------------------------------
TELECOM_MW_CHANGE_STREAM_ENABLED=true
TELECOM_MW_SSE_HEARTBEAT_S=15
TELECOM_MW_SSE_MAX_SUBSCRIBERS=500
TELECOM_MW_OUTBOX_BATCH_SIZE=100
TELECOM_MW_OUTBOX_POLL_INTERVAL_S=1.0

# --- Data protection ----------------------------------------------------------
TELECOM_MW_CASE_RETENTION_DAYS=90
TELECOM_MW_AUDIT_RETENTION_DAYS=2555     # seven years
TELECOM_MW_IDEMPOTENCY_TTL_S=86400
