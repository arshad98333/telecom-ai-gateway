# Every variable the application reads. Copy to .env and fill in.
# Nothing here is a real secret; the real .env is gitignored and never committed.

# --- Runtime -----------------------------------------------------------------
TELECOM_MCP_ENV=local                  # local | staging | production
TELECOM_MCP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
TELECOM_MCP_SERVICE_NAME=telecom-mcp-tools

# --- HTTP transport (only read when transport=http) --------------------------
TELECOM_MCP_HTTP_HOST=127.0.0.1
TELECOM_MCP_HTTP_PORT=8080

# --- Telecom middleware API (the only way we reach customer data) ------------
# The package never connects to MongoDB directly; it calls this service.
TELECOM_MCP_BACKEND=fake               # fake | http   (fake needs no network)
TELECOM_MCP_BACKEND_BASE_URL=https://middleware.example.invalid/api/v1
TELECOM_MCP_BACKEND_API_KEY=dummy-backend-key
TELECOM_MCP_BACKEND_CONNECT_TIMEOUT_S=2.0
TELECOM_MCP_BACKEND_READ_TIMEOUT_S=8.0
TELECOM_MCP_BACKEND_MAX_CONNECTIONS=50

# --- Identity ----------------------------------------------------------------
TELECOM_MCP_IDENTITY_VERIFIER=local       # local | jwks   (local is for tests/dev only)
TELECOM_MCP_JWKS_URL=https://tenant.eu.auth0.com/.well-known/jwks.json
TELECOM_MCP_JWT_ISSUER=https://tenant.eu.auth0.com/
TELECOM_MCP_JWT_AUDIENCE=telecom-mcp-tools
TELECOM_MCP_LOCAL_VERIFIER_SECRET=dummy-local-signing-secret-change-me-32b
TELECOM_MCP_JWKS_CACHE_TTL_S=600

# --- Reliability -------------------------------------------------------------
TELECOM_MCP_TOOL_TIMEOUT_S=10.0        # total budget per tool call (SOP: 10s)
TELECOM_MCP_RETRY_ATTEMPTS=2           # retries after the first try, safe operations only
TELECOM_MCP_RETRY_BASE_DELAY_S=0.2
TELECOM_MCP_BREAKER_FAILURE_THRESHOLD=5
TELECOM_MCP_BREAKER_RESET_TIMEOUT_S=30.0
TELECOM_MCP_MAX_CONCURRENT_TOOL_CALLS=100

# --- Idempotency -------------------------------------------------------------
TELECOM_MCP_IDEMPOTENCY_STORE=memory   # memory | redis
TELECOM_MCP_IDEMPOTENCY_TTL_S=86400    # 24 hours
TELECOM_MCP_REDIS_URL=redis://localhost:6379/0

# --- Audit -------------------------------------------------------------------
TELECOM_MCP_AUDIT_SINK=stdout          # stdout | file
TELECOM_MCP_AUDIT_FILE_PATH=./audit.log
